&Тест
&Параметры("SearchCode")
&Параметры("GraphQL")
Процедура ТестДолжен_ВернутьНеопределеноПриОграниченииЛимита(ТипЗапроса) Экспорт

	// Подготовка
	Если ТипЗапроса = "SearchCode" Тогда
		УстановитьЛимитПоискаКода(0);
	ИначеЕсли ТипЗапроса = "GraphQL" Тогда
		УстановитьРежимGraphQL("rate-limit");
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестный тип запроса: %1", ТипЗапроса);
	КонецЕсли;

	// Действие
	Ответ = ВыполнитьЗапросСОграничениемЛимита(ТипЗапроса);

	// Утверждение
	Ожидаем.Что(Ответ).ЭтоНеопределено();

КонецПроцедуры

